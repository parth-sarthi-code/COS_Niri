#!/usr/bin/env bash

# Nautilus sets NAUTILUS_SCRIPT_SELECTED_FILE_PATHS containing absolute paths of selected files.
# If run manually, it can also take the file path as the first argument ($1).
SELECTED_FILE="${1:-$NAUTILUS_SCRIPT_SELECTED_FILE_PATHS}"

# Use only the first selected file
SELECTED_FILE=$(echo "$SELECTED_FILE" | head -n 1)

if [ -f "$SELECTED_FILE" ]; then
    # Overwrite the persistent background file if it's different
    if [ "$SELECTED_FILE" != "$HOME/.config/background" ]; then
        cp "$SELECTED_FILE" "$HOME/.config/background"
    fi

    # Kill the existing wallpaper daemon
    pkill swaybg
    
    # Start swaybg, detached completely from Nautilus
    nohup swaybg -i "$HOME/.config/background" -m fill >/dev/null 2>&1 &
    
    # Trigger theme hot-reload on cos-niri-bar
    pkill -USR1 cos-niri-bar || true
    
    # Optional notification to confirm
    notify-send -t 2000 "Wallpaper Updated" "Set background to $(basename "$SELECTED_FILE")"
else
    notify-send -t 3000 "Set Wallpaper" "Please select a valid image file."
fi
